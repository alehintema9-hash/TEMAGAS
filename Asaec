rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Владелец TEMAGAS
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'alehintema9@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Проверка песни
    function validTrack() {
      return request.resource.data.keys().hasOnly([
        'title', 'artist', 'release_name',
        'cover_url', 'cover_data',
        'youtube_url', 'spotify_url',
        'other_url', 'other_label',
        'audio_url', 'audio_path',
        'lyrics', 'created_at', 'updated_at'
      ])
      && request.resource.data.keys().hasAll([
        'title', 'artist', 'release_name',
        'cover_url', 'cover_data',
        'youtube_url', 'spotify_url',
        'other_url', 'other_label',
        'lyrics', 'created_at'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 120
      && request.resource.data.artist is string
      && request.resource.data.artist.size() > 0
      && request.resource.data.artist.size() <= 120
      && request.resource.data.release_name is string
      && request.resource.data.release_name.size() <= 120
      && request.resource.data.cover_url is string
      && request.resource.data.cover_url.size() <= 2048
      && request.resource.data.cover_data is string
      && request.resource.data.cover_data.size() <= 400000
      && request.resource.data.youtube_url is string
      && request.resource.data.youtube_url.size() <= 2048
      && request.resource.data.spotify_url is string
      && request.resource.data.spotify_url.size() <= 2048
      && request.resource.data.other_url is string
      && request.resource.data.other_url.size() <= 2048
      && request.resource.data.other_label is string
      && request.resource.data.other_label.size() <= 40
      && request.resource.data.lyrics is string
      && request.resource.data.lyrics.size() > 0
      && request.resource.data.lyrics.size() <= 60000
      && request.resource.data.created_at is timestamp
      && (
        !request.resource.data.keys().hasAny(['audio_url'])
        || (
          request.resource.data.audio_url is string
          && request.resource.data.audio_url.size() <= 2048
        )
      )
      && (
        !request.resource.data.keys().hasAny(['audio_path'])
        || (
          request.resource.data.audio_path is string
          && request.resource.data.audio_path.size() <= 1024
        )
      )
      && (
        !request.resource.data.keys().hasAny(['updated_at'])
        || request.resource.data.updated_at is timestamp
      );
    }

    // Проверка текстового альбома
    function validTextAlbum() {
      return request.resource.data.keys().hasOnly([
        'title', 'artist', 'description',
        'cover_url', 'cover_data',
        'texts', 'created_at', 'updated_at'
      ])
      && request.resource.data.keys().hasAll([
        'title', 'artist', 'description',
        'cover_url', 'cover_data',
        'texts', 'created_at'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 120
      && request.resource.data.artist is string
      && request.resource.data.artist.size() > 0
      && request.resource.data.artist.size() <= 120
      && request.resource.data.description is string
      && request.resource.data.description.size() <= 2000
      && request.resource.data.cover_url is string
      && request.resource.data.cover_url.size() <= 2048
      && request.resource.data.cover_data is string
      && request.resource.data.cover_data.size() <= 400000
      && request.resource.data.texts is list
      && request.resource.data.texts.size() > 0
      && request.resource.data.texts.size() <= 50
      && request.resource.data.created_at is timestamp
      && (
        !request.resource.data.keys().hasAny(['updated_at'])
        || request.resource.data.updated_at is timestamp
      );
    }

    // Песни
    match /tracks/{trackId} {
      allow read: if true;

      allow create: if isOwner()
        && validTrack()
        && request.resource.data.created_at == request.time;

      allow update: if isOwner()
        && validTrack()
        && request.resource.data.created_at == resource.data.created_at;

      allow delete: if isOwner();
    }

    // Альбомы только с текстами
    match /text_albums/{albumId} {
      allow read: if true;

      allow create: if isOwner()
        && validTextAlbum()
        && request.resource.data.created_at == request.time;

      allow update: if isOwner()
        && validTextAlbum()
        && request.resource.data.created_at == resource.data.created_at;

      allow delete: if isOwner();
    }
  }
}

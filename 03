        $('audioStatus').textContent='Аудио загружено ✓';
      }
      const payload={title:$('title').value.trim(),artist:$('artist').value.trim(),release_name:$('releaseName').value.trim()||$('title').value.trim(),audio_url:audioUrl,cover_url:coverUrl,cover_data:coverData,youtube_url:safeURL($('youtubeUrl').value.trim())||'',spotify_url:safeURL($('spotifyUrl').value.trim())||'',other_url:safeURL($('otherUrl').value.trim())||'',other_label:$('otherLabel').value.trim()||'',lyrics:$('lyrics').value.trim()};
      const id=$('editId').value;
      if(id){
        payload.created_at=tracks.find(t=>t.id===id)?.created_at||firebase.firestore.FieldValue.serverTimestamp();
        payload.updated_at=firebase.firestore.FieldValue.serverTimestamp();
        await db.collection('tracks').doc(id).update(payload);
      }else{
        payload.created_at=firebase.firestore.FieldValue.serverTimestamp();
        await db.collection('tracks').add(payload);
      }
      showNotice('formNotice',id?'Изменения сохранены.':'Трек опубликован!','ok');
      $('trackForm').reset();$('artist').value='Temagas';$('editId').value='';editingCoverData='';editingAudioUrl='';$('audioFile').value='';$('audioStatus').textContent='';$('saveBtn').textContent='ОПУБЛИКОВАТЬ ТРЕК';$('cancelEdit').hidden=true;
      await loadTracks();
    }catch(err){
      showNotice('formNotice','Ошибка: '+err.message,'error');
    }finally{btn.disabled=false;if(btn.textContent==='СОХРАНЯЕМ…')btn.textContent='ОПУБЛИКОВАТЬ ТРЕК';}
  });

  function startEdit(id){
    const t=tracks.find(x=>x.id===id);if(!t)return;
    $('editId').value=t.id;$('title').value=t.title||'';$('artist').value=t.artist||'';$('releaseName').value=t.release_name||'';$('coverUrl').value=t.cover_url||'';$('youtubeUrl').value=t.youtube_url||'';$('spotifyUrl').value=t.spotify_url||'';$('otherUrl').value=t.other_url||'';$('otherLabel').value=t.other_label||'';$('lyrics').value=t.lyrics||'';
    editingCoverData=t.cover_data||'';editingAudioUrl=t.audio_url||'';
    $('audioStatus').textContent=editingAudioUrl?'У трека уже есть аудио.':'';
    $('saveBtn').textContent='СОХРАНИТЬ ИЗМЕНЕНИЯ';$('cancelEdit').hidden=false;
    $('adminPanel').scrollIntoView({behavior:'smooth'});
  }

  $('cancelEdit').addEventListener('click',()=>{$('trackForm').reset();$('artist').value='Temagas';$('editId').value='';editingCoverData='';editingAudioUrl='';$('audioFile').value='';$('audioStatus').textContent='';$('saveBtn').textContent='ОПУБЛИКОВАТЬ ТРЕК';$('cancelEdit').hidden=true;hideNotice('formNotice');});

  async function deleteTrack(id){
    const t=tracks.find(x=>x.id===id);if(!t||!confirm(`Удалить «${t.title}»?`))return;
    try{await db.collection('tracks').doc(id).delete();await loadTracks();}catch(e){alert('Ошибка: '+e.message);}
  }

  function openAddTab(){if(!isOwner){$('loginModal').classList.add('show');return;}$('adminPanel').classList.add('show');$('adminPanel').scrollIntoView({behavior:'smooth'});switchAdminTab('song');}
  function switchAdminTab(tab){
    document.querySelectorAll('[data-admin-tab]').forEach(b=>b.classList.toggle('active',b.dataset.adminTab===tab));
    $('adminSongPage').classList.toggle('active',tab==='song');
    $('adminTextAlbumPage').classList.toggle('active',tab==='textAlbum');
    $('adminManagePage').classList.toggle('active',tab==='manage');
    if(tab==='manage')renderAdminList();
  }

  function renderAdminList(){
    const box=$('adminManageList');if(!box)return;
    if(!isOwner){box.textContent='Войди как владелец.';return;}
    const songRows=tracks.map(t=>`<div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px;border-bottom:1px solid var(--line)"><div><b>${escapeHTML(t.title)}</b><div class="artist">Песня · ${escapeHTML(t.artist||'')}</div></div><button class="secondary" data-manage-edit="${escapeHTML(t.id)}">Изменить</button></div>`).join('');
    const albumRows=textAlbums.map(a=>`<div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px;border-bottom:1px solid var(--line)"><div><b>${escapeHTML(a.title)}</b><div class="artist">Альбом · ${escapeHTML(a.artist||'')}</div></div><button class="secondary" data-manage-edit-album="${escapeHTML(a.id)}">Изменить</button></div>`).join('');
    box.innerHTML=(songRows+albumRows)||'Пока нет публикаций.';
  }

  function startAlbumEdit(id){
    const a=textAlbums.find(x=>x.id===id);if(!a)return;
    $('editAlbumId').value=a.id;$('albumTitle').value=a.title||'';$('albumArtist').value=a.artist||'';$('albumDescription').value=a.description||'';$('albumCoverUrl').value=a.cover_url||'';$('albumSongs').value=albumSongsToText(a.songs);
    editingAlbumCoverData=a.cover_data||'';
    $('saveAlbumBtn').textContent='СОХРАНИТЬ ИЗМЕНЕНИЯ';$('cancelAlbumEdit').hidden=false;
    switchAdminTab('textAlbum');$('adminPanel').scrollIntoView({behavior:'smooth'});
  }

  async function deleteTextAlbum(id){
    const a=textAlbums.find(x=>x.id===id);if(!a||!confirm(`Удалить «${a.title}»?`))return;
    try{await db.collection('text_albums').doc(id).delete();await loadTextAlbums();}catch(e){alert('Ошибка: '+e.message);}
  }

  $('textAlbumForm').addEventListener('submit',async e=>{
    e.preventDefault();
    if(!db||!isOwner){showNotice('albumFormNotice','Только владелец.','error');return;}
    const btn=$('saveAlbumBtn');btn.disabled=true;btn.textContent='СОХРАНЯЕМ…';
    try{
      const songs=parseAlbumSongs($('albumSongs').value);
      if(!songs.length)throw new Error('Добавь хотя бы одну песню.');
      let coverUrl=safeURL($('albumCoverUrl').value.trim())||'';let coverData=editingAlbumCoverData;
      const file=$('albumCoverFile').files[0];if(file){coverData=await compressCover(file);coverUrl='';}else if(coverUrl){coverData='';}
      const payload={title:$('albumTitle').value.trim(),artist:$('albumArtist').value.trim(),description:$('albumDescription').value.trim(),cover_url:coverUrl,cover_data:coverData,songs};
      const id=$('editAlbumId').value;
      if(id){
        payload.updated_at=firebase.firestore.FieldValue.serverTimestamp();
        await db.collection('text_albums').doc(id).update(payload);
      }else{
        payload.created_at=firebase.firestore.FieldValue.serverTimestamp();
        await db.collection('text_albums').add(payload);
      }
      showNotice('albumFormNotice',id?'Альбом изменен.':'Альбом опубликован!','ok');
      $('textAlbumForm').reset();$('albumArtist').value='Temagas';$('editAlbumId').value='';editingAlbumCoverData='';$('saveAlbumBtn').textContent='ОПУБЛИКОВАТЬ АЛЬБОМ';$('cancelAlbumEdit').hidden=true;
      await loadTextAlbums();
    }catch(err){
      showNotice('albumFormNotice','Ошибка: '+err.message,'error');
    }finally{btn.disabled=false;if(btn.textContent==='СОХРАНЯЕМ…')btn.textContent='ОПУБЛИКОВАТЬ АЛЬБОМ';}
  });

  $('cancelAlbumEdit').addEventListener('click',()=>{$('textAlbumForm').reset();$('albumArtist').value='Temagas';$('editAlbumId').value='';editingAlbumCoverData='';$('saveAlbumBtn').textContent='ОПУБЛИКОВАТЬ АЛЬБОМ';$('cancelAlbumEdit').hidden=true;hideNotice('albumFormNotice');});

  $('addTabButton').addEventListener('click',openAddTab);
  document.querySelectorAll('[data-admin-tab]').forEach(b=>b.addEventListener('click',()=>switchAdminTab(b.dataset.adminTab)));
  
  $('adminManageList').addEventListener('click',e=>{
    const b=e.target.closest('[data-manage-edit]');
    const ab=e.target.closest('[data-manage-edit-album]');
    if(b){switchAdminTab('song');startEdit(b.dataset.manageEdit);}
    else if(ab)startAlbumEdit(ab.dataset.manageEditAlbum);
  });

  $('textAlbumGrid').addEventListener('click',e=>{
    const open=e.target.closest('[data-open-album]');
    const edit=e.target.closest('[data-edit-album]');
    const del=e.target.closest('[data-delete-album]');
    if(open){e.preventDefault();openTextAlbum(open.dataset.openAlbum);}
    else if(edit)startAlbumEdit(edit.dataset.editAlbum);
    else if(del)deleteTextAlbum(del.dataset.deleteAlbum);
  });

  $('trackGrid').addEventListener('click',e=>{
    const edit=e.target.closest('[data-edit]');
    const del=e.target.closest('[data-delete]');
    const open=e.target.closest('[data-open]');
    if(edit)startEdit(edit.dataset.edit);
    else if(del)deleteTrack(del.dataset.delete);
    else if(open)openSong(open.dataset.open);
  });

  $('searchInput').addEventListener('input',e=>{currentQuery=e.target.value.trim();render();});
  $('searchBtn').addEventListener('click',()=>{currentQuery=$('searchInput').value.trim();render();});

  document.querySelectorAll('[data-kind]').forEach(b=>b.addEventListener('click',()=>{
    document.querySelectorAll('[data-kind]').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    currentKind=b.dataset.kind;
    render();
  }));

  document.querySelectorAll('nav [data-filter]').forEach(b=>b.addEventListener('click',()=>{
    document.querySelectorAll('nav [data-filter]').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    currentNav=b.dataset.filter;
    if(currentNav==='tracks') currentNav='all';
    if(currentNav==='artists') currentKind='all';
    render();
    const targetId = (b.dataset.filter === 'textAlbums') ? 'textAlbumsSection' : 'collection';
    $(targetId).scrollIntoView({behavior:'smooth'});
  }));

  $('year').textContent=new Date().getFullYear();

  if(auth){
    auth.onAuthStateChanged(async user=>{refreshOwner(user);await Promise.all([loadTracks(),loadTextAlbums()]);});
  }else{
    refreshOwner(null);loadTracks();loadTextAlbums();
  }
</script>
</body>
</html>

</head>
<body data-theme="dark">
<header>
  <div class="wrap top">
    <a class="brand" href="#home" aria-label="TEMAGAS"><span class="brand-mark">T.</span><span>TEMA<em>GAS</em></span></a>
    <nav aria-label="Основная навигация">
      <button class="active" data-filter="home">Главная</button>
      <button data-filter="tracks">Песни</button>
      <button data-filter="artists">Исполнители</button>
      <button data-filter="releases">Релизы</button>
      <button data-filter="textAlbums">Текстовые альбомы</button>
      <button id="addTabButton" style="display:none">Добавить</button>
    </nav>
    <div class="header-actions">
      <button class="theme-toggle" id="themeToggle" aria-label="Сменить тему">💡</button>
      <button class="owner-open" id="ownerOpen">ВХОД ВЛАДЕЛЬЦА ↗</button>
    </div>
  </div>
</header>
<main class="wrap" id="home">
  <section class="hero">
    <div>
      <div class="eyebrow"><span class="dot"></span> Музыка. Слова. Смысл.</div>
      <h1>ВСЕ ТЕКСТЫ<br><span>ТУТ.</span></h1>
      <p>TEMAGAS — место, где собраны тексты песен, релизы и ссылки на музыку. Читай, находи любимые треки и открывай новые имена.</p>
      <div class="search"><input id="searchInput" type="search" placeholder="Найти песню или исполнителя..." autocomplete="off"><button id="searchBtn">НАЙТИ</button></div>
    </div>
    <div class="hero-art"><div class="art-ring"><div class="art-inner">T.</div></div><div class="stamp">ALL LYRICS HERE · 2026</div></div>
  </section>
  
  <!-- Динамическая статистика (скрывается, если данных нет) -->
  <section class="stats hidden" id="statsSection" aria-label="Статистика">
    <div class="stat"><b id="trackCount">0</b><span>Треков</span></div>
    <div class="stat"><b id="artistCount">0</b><span>Исполнителей</span></div>
    <div class="stat"><b id="releaseCount">0</b><span>Релизов</span></div>
  </section>

  <div id="connectionNotice" class="notice" style="display:none">Подключение к каталогу…</div>
  <section id="collection">
    <div class="section-head">
      <div><h2 id="collectionTitle">Популярные тексты</h2><p>Открывай треки и читай тексты</p></div>
      <div class="filters" aria-label="Тип релиза">
        <button class="filter active" data-kind="all">Все</button>
        <button class="filter" data-kind="Single">Singles</button>
        <button class="filter" data-kind="EP">EP</button>
        <button class="filter" data-kind="Album">Albums</button>
      </div>
    </div>
    <div class="track-grid" id="trackGrid"><div class="empty"><b>Загружаем каталог…</b>Подключаем песни TEMAGAS.</div></div>
  </section>
  <section id="textAlbumsSection" style="display:none">
    <div class="section-head"><div><h2>Текстовые альбомы</h2><p>Альбомы, которые можно читать без аудио</p></div></div>
    <div class="track-grid" id="textAlbumGrid"><div class="empty"><b>Загружаем альбомы…</b></div></div>
  </section>
  <section class="admin-panel" id="adminPanel">
    <div class="admin-head"><div><h2>Добавить музыку</h2><small>● Вход выполнен: только владелец может публиковать</small></div><button class="secondary" id="logoutBtn">Выйти</button></div>
    <div class="admin-tabs"><button class="admin-tab active" data-admin-tab="song">＋ Новая песня</button><button class="admin-tab" data-admin-tab="textAlbum">＋ Текстовый альбом</button><button class="admin-tab" data-admin-tab="manage">Мои публикации</button></div>
    <div class="admin-page active" id="adminSongPage">
    <form id="trackForm">
      <input type="hidden" id="editId">
      <div class="form-grid">
        <div class="field"><label for="title">Название трека *</label><input id="title" required maxlength="120" placeholder="Например, Ночной город"></div>
        <div class="field"><label for="artist">Исполнитель *</label><input id="artist" required maxlength="120" value="Temagas"></div>
        <div class="field"><label for="releaseName">Название релиза</label><input id="releaseName" maxlength="120" placeholder="Название сингла / EP / альбома"></div>
        <div class="field"><label for="coverFile">Обложка (файл изображения)</label><input id="coverFile" type="file" accept="image/png,image/jpeg,image/webp,image/gif"></div>
        <div class="field"><label for="coverUrl">Или ссылка на обложку</label><input id="coverUrl" type="url" placeholder="https://..."></div>
        <div class="field full"><div class="upload-card"><label for="audioFile">Аудиофайл трека (MP3, WAV, M4A, OGG)</label><p>Загрузи сам трек — на странице песни появится плеер. Максимум 25 МБ.</p><input id="audioFile" type="file" accept="audio/mpeg,audio/mp3,audio/wav,audio/x-wav,audio/mp4,audio/ogg,audio/aac"><div id="audioStatus" class="upload-progress"></div></div></div>
        <div class="field"><label for="youtubeUrl">YouTube</label><input id="youtubeUrl" type="url" placeholder="https://youtube.com/..."></div>
        <div class="field"><label for="spotifyUrl">Spotify</label><input id="spotifyUrl" type="url" placeholder="https://open.spotify.com/..."></div>
        <div class="field"><label for="otherUrl">Другая ссылка</label><input id="otherUrl" type="url" placeholder="https://..."></div>
        <div class="field"><label for="otherLabel">Название другой ссылки</label><input id="otherLabel" maxlength="40" placeholder="Например, Bandcamp"></div>
        <div class="field full"><label for="lyrics">Текст песни *</label><textarea id="lyrics" required placeholder="Вставь сюда свой текст песни…"></textarea></div>
      </div>
      <div class="form-actions"><button class="primary" type="submit" id="saveBtn">ОПУБЛИКОВАТЬ ТРЕК</button><button class="secondary" type="button" id="cancelEdit" hidden>Отмена редактирования</button></div>
      <div id="formNotice" aria-live="polite"></div>
    </form>
    </div>
    <div class="admin-page" id="adminTextAlbumPage">
      <form id="textAlbumForm">
        <input type="hidden" id="editAlbumId">
        <div class="form-grid">
          <div class="field"><label for="albumTitle">Название альбома *</label><input id="albumTitle" required maxlength="120" placeholder="Например, Между строк"></div>
          <div class="field"><label for="albumArtist">Исполнитель *</label><input id="albumArtist" required maxlength="120" value="Temagas"></div>
          <div class="field full"><label for="albumDescription">Описание альбома</label><textarea id="albumDescription" style="min-height:90px" maxlength="2000" placeholder="Коротко расскажи об альбоме…"></textarea></div>
          <div class="field"><label for="albumCoverFile">Обложка (изображение)</label><input id="albumCoverFile" type="file" accept="image/png,image/jpeg,image/webp,image/gif"></div>
          <div class="field"><label for="albumCoverUrl">Или ссылка на обложку</label><input id="albumCoverUrl" type="url" placeholder="https://..."></div>
          <div class="field full"><label for="albumSongs">Песни и тексты *</label><p style="color:var(--muted);font-size:12px;margin:0">Формат: строка с названием, затем текст. Между песнями строка с ---.</p><textarea id="albumSongs" required style="min-height:260px" placeholder="Название первой песни&#10;Текст первой песни…&#10;&#10;---&#10;&#10;Название второй песни&#10;Текст второй песни…"></textarea></div>
        </div>
        <div class="form-actions"><button class="primary" type="submit" id="saveAlbumBtn">ОПУБЛИКОВАТЬ АЛЬБОМ</button><button class="secondary" type="button" id="cancelAlbumEdit" hidden>Отмена редактирования</button></div>
        <div id="albumFormNotice" aria-live="polite"></div>
      </form>
    </div>
    <div class="admin-page" id="adminManagePage"><div class="empty" id="adminManageList">Загружаем твои публикации…</div></div>
  </section>
</main>

<!-- Sticky Audio Player Bar -->
<div class="sticky-player" id="stickyPlayer">
  <div class="sp-info">
    <div class="sp-cover" id="spCoverContainer"><span id="spCoverMark">T.</span></div>
    <div class="sp-meta">
      <div class="sp-title" id="spTitle">Название трека</div>
      <div class="sp-artist" id="spArtist">Исполнитель</div>
    </div>
  </div>
  <div class="sp-controls">
    <button class="sp-btn" id="spPlayBtn">▶</button>
    <div class="sp-progress-wrap">
      <span class="sp-time" id="spCurrentTime">0:00</span>
      <input type="range" class="sp-slider" id="spSlider" value="0" min="0" max="100" step="0.1">

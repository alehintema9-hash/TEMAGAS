;background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:22px;margin:28px 0 40px}.admin-panel.show{display:block}.admin-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 20px}.admin-tab{background:var(--panel2);border:1px solid var(--line);color:var(--text);border-radius:10px;padding:10px 14px;font-size:13px;font-weight:800}.admin-tab.active{background:var(--yellow);border-color:var(--yellow);color:#090909}.admin-page{display:none}.admin-page.active{display:block}.upload-card{background:var(--panel2);border:1px dashed var(--line);border-radius:14px;padding:16px}.upload-card p{color:var(--muted);font-size:12px;margin:6px 0 12px}.upload-card input[type=file]{width:100%}.upload-progress{font-size:12px;color:var(--yellow);margin-top:8px}.admin-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:18px}.admin-head h2{font-size:21px;margin:0}.admin-head small{color:var(--green);font-weight:800}.form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.field{display:flex;flex-direction:column;gap:6px}.field.full{grid-column:1/-1}.field label{font-size:12px;color:var(--muted);font-weight:800}.field input,.field textarea{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:12px 13px;color:var(--text);outline:none;width:100%;font-size:14px}.field textarea{min-height:155px;resize:vertical;line-height:1.6}.field input[type=file]{padding:9px}.form-actions{display:flex;gap:10px;margin-top:15px;flex-wrap:wrap}.secondary{background:var(--panel2);color:var(--text);border:1px solid var(--line);font-weight:800}.track-admin-actions{display:flex;gap:6px;margin-top:12px}.track-admin-actions button{background:var(--panel2);color:var(--text);border:1px solid var(--line);border-radius:7px;padding:7px 10px;font-size:11px;font-weight:700}.modal{display:none;position:fixed;inset:0;z-index:20;background:rgba(0,0,0,.78);backdrop-filter:blur(8px);padding:20px;place-items:center}.modal.show{display:grid}.modal-card{width:min(440px,100%);background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:0 30px 100px rgba(0,0,0,0.5)}.modal-card h2{margin:0 0 7px;font-size:23px}.modal-card p{margin:0 0 18px;color:var(--muted);font-size:13px;line-height:1.6}.modal-card .field{margin:12px 0}.modal-card .primary{width:100%;margin-top:7px}.close{float:right;background:var(--panel2);border:0;color:var(--text);border-radius:8px;width:32px;height:32px;font-weight:bold}.footer{border-top:1px solid var(--line);margin-top:60px;padding:28px 0 36px;color:var(--muted);font-size:12px}.footer-row{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.footer strong{color:var(--yellow);letter-spacing:1px}.song-modal .modal-card{max-height:90vh;overflow:auto}.song-modal .modal-card h2{font-size:28px}.lyrics{white-space:pre-wrap;background:var(--panel2);border:1px solid var(--line);padding:18px;border-radius:12px;font-size:15px;line-height:1.9;color:var(--text);margin-top:16px}.song-modal .cover{height:210px;border-radius:12px;margin:12px 0}

    /* Sticky Player Styles */
    .sticky-player{position:fixed;bottom:0;left:0;right:0;background:var(--panel);border-top:1px solid var(--line);padding:12px 20px;display:none;align-items:center;justify-content:space-between;gap:15px;z-index:100;box-shadow:0 -10px 30px rgba(0,0,0,0.3);backdrop-filter:blur(15px)}.sticky-player.show{display:flex}.sp-info{display:flex;align-items:center;gap:12px;min-width:0;flex:1}.sp-cover{width:46px;height:46px;border-radius:8px;background:var(--panel2);object-fit:cover;flex-shrink:0;display:grid;place-items:center;color:var(--yellow);font-weight:800}.sp-meta{min-width:0}.sp-title{font-weight:800;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sp-artist{font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sp-controls{display:flex;align-items:center;gap:15px;flex:2;max-width:500px}.sp-btn{background:var(--yellow);color:#090909;border:0;width:38px;height:38px;border-radius:50%;display:grid;place-items:center;font-weight:900;flex-shrink:0}.sp-progress-wrap{display:flex;align-items:center;gap:10px;width:100%}.sp-time{font-size:11px;color:var(--muted);width:35px;text-align:center}.sp-slider{flex:1;-webkit-appearance:none;background:var(--line);height:5px;border-radius:3px;outline:none}.sp-slider::-webkit-slider-thumb{-webkit-appearance:none;width:12px;height:12px;border-radius:50%;background:var(--yellow);cursor:pointer}.sp-close{background:transparent;border:0;color:var(--muted);font-size:18px;padding:5px}.sp-close:hover{color:var(--text)}

    /* Toast Notification */
    .toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--yellow);color:#090909;padding:10px 20px;border-radius:99px;font-weight:800;font-size:13px;box-shadow:0 10px 30px rgba(0,0,0,0.2);opacity:0;pointer-events:none;transition:.3s;z-index:200}.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

    @media(max-width:800px){.top{height:auto;min-height:70px;flex-wrap:wrap;padding:12px 0}nav{order:3;width:100%;overflow:auto}nav button{white-space:nowrap}.hero{grid-template-columns:1fr;padding-top:42px}.hero-art{display:none}.track-grid{grid-template-columns:repeat(2,1fr)}.section-head{align-items:start;flex-direction:column}.stats{margin-bottom:30px}.sticky-player{flex-direction:column;align-items:stretch;gap:10px}.sp-controls{max-width:100%}}
    @media(max-width:520px){.wrap{width:min(100% - 26px,1160px)}.brand{font-size:21px}.owner-open{padding:10px 12px}.hero{padding-top:35px}h1{letter-spacing:-3px}.search{flex-direction:column}.search button{min-height:48px}.stats{gap:7px}.stat{padding:13px}.stat b{font-size:22px}.stat span{font-size:10px}.track-grid{grid-template-columns:1fr 1fr;gap:9px}.cover{height:135px}.track-body{padding:12px}.track h3{font-size:14px}.artist{font-size:11px}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.section-head h2{font-size:22px}}

  <style>
    :root{--bg:#090909;--panel:#121212;--panel2:#181818;--line:#282828;--text:#f4f2eb;--muted:#b0aea5;--yellow:#f5e600;--yellow2:#d8cb00;--danger:#ff6868;--green:#8ed6a5;--radius:18px}

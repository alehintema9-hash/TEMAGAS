    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 78% -10%,rgba(245,230,0,.09),transparent 32%),var(--bg);color:var(--text);font-family:Manrope,Arial,sans-serif;min-height:100vh;transition:background .3s,color .3s}button,input,textarea,select{font:inherit}button{cursor:pointer}.wrap{width:min(1160px,calc(100% - 40px));margin:auto}
    header{position:sticky;top:0;z-index:5;background:var(--bg);opacity:.95;backdrop-filter:blur(18px);border-bottom:1px solid var(--line);transition:background .3s,border-color .3s}.top{height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;align-items:center;gap:11px;color:var(--text);text-decoration:none;font-weight:900;letter-spacing:-1.5px;font-size:25px}.brand-mark{width:37px;height:37px;background:var(--yellow);color:#080808;border-radius:11px;display:grid;place-items:center;font-size:17px;font-weight:1000;letter-spacing:-2px;transform:rotate(-5deg)}.brand em{font-style:normal;color:var(--yellow)}nav{display:flex;align-items:center;gap:8px}nav button,.nav-link{background:transparent;border:0;color:var(--muted);text-decoration:none;padding:10px 13px;border-radius:10px;font-weight:700;font-size:14px}nav button:hover,nav button.active{background:var(--panel2);color:var(--yellow)}.header-actions{display:flex;align-items:center;gap:10px}.theme-toggle{background:var(--panel2);border:1px solid var(--line);color:var(--text);width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font-size:16px}.owner-open{background:var(--yellow);color:#090909;border:0;border-radius:999px;padding:11px 17px;font-weight:900;font-size:12px}.owner-open:hover,.primary:hover{background:var(--yellow2)}.hero{padding:65px 0 34px;display:grid;grid-template-columns:1.15fr .85fr;gap:30px;align-items:center}.eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--yellow);font-size:12px;font-weight:900;letter-spacing:2px;text-transform:uppercase}.dot{width:7px;height:7px;background:var(--yellow);border-radius:50%;box-shadow:0 0 15px var(--yellow)}h1{font-size:clamp(45px,7vw,78px);line-height:.98;letter-spacing:-5px;margin:18px 0 16px;font-weight:900}h1 span{color:var(--yellow)}.hero p{color:var(--muted);font-size:16px;line-height:1.7;max-width:530px;margin:0 0 26px}.search{display:flex;gap:10px;max-width:620px}.search inpu